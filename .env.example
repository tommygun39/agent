# Google Gemini API Key (Obtine cheia de la https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Model AI implicit (gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash)
DEFAULT_MODEL=gemini-2.0-flash

# Baza de date (implicit SQLite local stocat in ./data/agent.db)
# Optional se poate conecta la PostgreSQL/Supabase: postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/agent.db

# Nume Asistent & Limba
ASSISTANT_NAME=Pandele
ASSISTANT_LANGUAGE=ro

# Setari Server
HOST=0.0.0.0
PORT=8000
